@model DetailsViewModel

@{
    ViewData["Title"] = "Project Details";
}

<section class="project-details-page">
    <div class="container">

        <!-- Title + Back button -->
        <div class="details-header">
            <h1 class="project-details-title">@Model.Name</h1>
            <a asp-controller="@Model.CraftName" asp-action="All" class="craft-button">
                Back to Projects
            </a>
        </div>

        <!-- Details + Image -->
        <div class="details-content">
            <div class="patchwork-square">
                <div class="patch-content">
                    <p><strong>Difficulty:</strong> @Model.Difficulty</p>
                    <p><strong>Project Type:</strong> @Model.ProjectTypeName</p>
                </div>
            </div>
            <div class="details-text">
                <p>@Model.Description</p>

                <div class="details-buttons">
                    <a asp-controller="Craft" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-welcome">Edit</a>

                    <a asp-controller="Craft" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-delete btn-danger">
                        Delete
                    </a>

                    <a asp-controller="Craft" asp-action="StartProject" asp-route-id="@Model.Id" class="btn btn-welcome btn-start">
                        @(Model.IsStarted && !Model.IsFinished ? "Finish Project" : "Start Project")</a>
                </div>
            </div>

            <div class="details-image-wrapper">
                <img src="@Url.Content(string.IsNullOrEmpty(Model.ImgUrl)
                                                                         ? "~/images/istockphoto-1499593982-612x612.jpg"
                                                                         : Model.ImgUrl)" 
                alt="@Model.Name" class="details-image" />
            </div>
        </div>
    </div>
</section>
