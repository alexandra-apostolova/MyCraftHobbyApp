@model DetailsViewModel

@{
	ViewData["Title"] = "Project Details";
}

<section class="project-details-page">
	<div class="container">

		<div class="details-header">
			<h1 class="project-details-title">@Model.Name</h1>
			<a asp-controller="Craft" asp-action="@(Model.StitchPattern != null ? "CrochetAll" : "KnitAll")" class="craft-button">
				Back to Projects
			</a>
		</div>

		<div class="details-content">
			<div class="patchwork-square">
				<div class="patch-content">
					<p><strong>Difficulty:</strong> @Model.Difficulty</p>
					<p><strong>Project Type:</strong> @Model.ProjectTypeName</p>
					@if (Model.StitchPattern != null)
					{
						<p><strong>Stitch Pattern:</strong> @Model.StitchPattern</p>
					}
				</div>
			</div>
			<div class="details-text">
				@if (Model.Description == null)
				{
					<p class="italic-text">No description available.</p>
				}
				<p>@Model.Description</p>

				<div class="details-buttons">
					@if (Model.IsCreator)
					{
						<a asp-controller="Craft" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-welcome">Edit</a>

						<a asp-controller="Craft" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-delete btn-danger">
							Delete
						</a>
					}
					else 
					{
						<a asp-controller="Craft" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-welcome disabled">Edit</a>

						<a asp-controller="Craft" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-delete btn-danger disabled">
							Delete
						</a>
					}
					<form method="post" asp-controller="Craft"
						  asp-action="ToggleStartFinishProject"
						  asp-route-id="@Model.Id">
						<button type="submit" class="btn btn-welcome btn-start">
							@(Model.IsStarted && !Model.IsFinished ? "Finish Project" : "Start Project")</button>
					</form>
				</div>
			</div>

			@if(Model.StitchPattern == null)
			{
				<div class="details-image-wrapper">
					<img src="@Url.Content(string.IsNullOrEmpty(Model.ImgUrl)
											? "~/images/istockphoto-1499593982-612x612.jpg"
											: Model.ImgUrl)"
					 alt="@Model.Name" class="details-image" />
				</div>
			}
			else
			{
				<div class="details-image-wrapper">
					<img src="@Url.Content(string.IsNullOrEmpty(Model.ImgUrl)
											? "~/images/istockphoto-1311419248-612x612.jpg"
											: Model.ImgUrl)"
					 alt="@Model.Name" class="details-image" />
			</div>
			}

		</div>
	</div>
</section>
