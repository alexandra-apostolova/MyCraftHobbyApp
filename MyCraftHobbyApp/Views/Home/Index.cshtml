@{
    ViewData["Title"] = "Pick Your Craft";
}

<div class="welcome-container">
    <h1 class="welcome-title">Pick your craft!</h1>

    <div class="craft-options">
        <!-- Knitting -->
        <div class="craft-card">
            <img src=@Url.Content("~/images/istockphoto-1499593982-612x612.jpg")
                 alt="Knitting project"
                 class="craft-image" />

            <h2>Knitting</h2>

            <a asp-controller="Knit"
               asp-action="All"
               class="craft-button">
                Explore Knits
            </a>
        </div>

        <!-- Crochet -->
        <div class="craft-card">
            <img src=@Url.Content("~/images/istockphoto-1311419248-612x612.jpg")
                 alt="Crochet project"
                 class="craft-image" />

            <h2>Crochet</h2>

            <a asp-controller="Crochet"
               asp-action="All"
               class="craft-button">
                Explore Crochet
            </a>
        </div>
    </div>
</div>

