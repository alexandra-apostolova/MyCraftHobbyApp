@model DeleteViewModel

@{
    ViewData["Title"] = "Delete Project";
}

<div class="delete-card">
    <h2>Are you sure you want to delete this project?</h2>

    <div class="delete-title">
        @Model.Name
    </div>

    <div class="button-row">
        <form method="post" asp-action="Delete" asp-route-id="@Model.Id">
            <button type="submit" class="btn btn-delete">Confirm</button>
        </form>
        <a asp-controller="Knit" asp-action="All" asp-route-id="@Model.Id" class="btn btn-cancel">
            Cancel
        </a>
    </div>
</div>