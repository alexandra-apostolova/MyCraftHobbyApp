@model ICollection<AllViewModel>

@{
    ViewData["Title"] = "All Knit Projects";
}

<section class="projects-page">
    <div class="container">
        <div class="projects-header">
            <h1 class="projects-title">All Knit Projects</h1>
            <a asp-controller="Knit" asp-action="Create" class="craft-button">
                + Add New Project
            </a>
        </div>

        <div class="projects-row">
            @foreach (var project in Model)
            {
                <div class="craft-card">
                    <div class="craft-image-wrapper">
                        <img src="@Url.Content(string.IsNullOrEmpty(project.ImgUrl)
                                                                                 ? "~/images/istockphoto-1499593982-612x612.jpg"
                                                                                 : project.ImgUrl)"
                         alt="@project.Name" 
                         class="craft-image" />
                    </div>

                    <h3 class="project-title">@project.Name</h3>
                    <p class="project-difficulty">@project.Difficulty</p>

                    <div class="project-buttons">
                        <a asp-controller="Knit" asp-action="Details" asp-route-id="@project.Id" class="btn btn-details">
                            View Details
                        </a>
                        <div class="button-row">
                            <a asp-controller="Knit" asp-action="Edit" asp-route-id="@project.Id" class="btn btn-edit">
                                Edit
                            </a>
                            <a asp-controller="Knit" asp-action="Delete" asp-route-id="@project.Id" class="btn btn-delete btn-danger">
                                 Delete
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
