@using MyCraftHobbyApp.GCommon.Enums
@model IEnumerable<AllUserProjectsViewModel>

@{
	ViewData["Title"] = "My Projects";

	var created = Model.Where(p => p.IsCreator);
	var started = Model.Where(p => p.IsStarted && !p.IsFinished);
	var finished = Model.Where(p => p.IsFinished);
}

<section class="projects-page">

	<div class="projects-header">
		<h1 class="project-details-title">My Projects</h1>
		<a asp-controller="Craft" asp-action="CreateKnit" class="craft-button">
			+ Add New Knit Project
		</a>
		<a asp-controller="Craft" asp-action="CreateCrochet" class="craft-button">
			+ Add New Crochet Project
		</a>
	</div>

	<div class="projects-columns">

		<!-- CREATED -->
		<div class="projects-column">
			<h3 class="column-title">Created</h3>

			@if (!created.Any())
			{
				<div class="patchwork-square">
					<div class="patch-content">
						<p>No created projects yet</p>
					</div>
				</div>
			}
			else
			{
				@foreach (var project in created)
				{
					<div class="project-strip-wrapper">

						<!-- Text + Image link -->
						<a asp-controller="Craft"
						   asp-action="Details"
						   asp-route-id="@project.Id"
						   class="project-strip-link">

							<div class="project-strip">

								<div class="project-strip-text">
									<h5>@project.Name</h5>
									<div class="project-meta">
										<span>@project.CraftType</span> ·
										<span>@project.Difficulty</span>
									</div>
								</div>

								@if (project.CraftType == CraftType.Crochet)
								{
									<img src="@Url.Content(string.IsNullOrEmpty(project.ImgUrl)
																						   ? "~/images/istockphoto-1311419248-612x612.jpg"
																						   : project.ImgUrl)"
							 alt="@project.Name" class="project-strip-image" />
												}
								else
								{
									<img src="@Url.Content(string.IsNullOrEmpty(project.ImgUrl)
																						   ? "~/images/istockphoto-1499593982-612x612.jpg"
																						   : project.ImgUrl)"
							 alt="@project.Name" class="project-strip-image" />
												}

							</div>
						</a>

						<!-- Buttons below the strip -->
						<div class="project-strip-bottom">
							<div class="button-row">
								<a asp-controller="Craft"
								   asp-action="Edit"
								   asp-route-id="@project.Id"
								   class="btn btn-edit">
									Edit
								</a>

								<a asp-controller="Craft"
								   asp-action="Delete"
								   asp-route-id="@project.Id"
								   class="btn btn-delete">
									Delete
								</a>
							</div>
						</div>

					</div>
				}

			}
		</div>

		<!-- STARTED -->
		<div class="projects-column">
			<h3 class="column-title">Started</h3>
			@if (!started.Any())
			{
				<div class="patchwork-square">
					<div class="patch-content">
						<p>No started projects yet</p>
					</div>
				</div>
			}
			else
			{
				@foreach (var project in started)
				{
					<div class="project-strip-wrapper">

						<!-- Text + Image link -->
						<a asp-controller="Craft"
						   asp-action="Details"
						   asp-route-id="@project.Id"
						   class="project-strip-link">

							<div class="project-strip">

								<div class="project-strip-text">
									<h5>@project.Name</h5>
									<div class="project-meta">
										<span>@project.CraftType</span> ·
										<span>@project.Difficulty</span>
									</div>
								</div>

								@if (project.CraftType == CraftType.Crochet)
								{
									<img src="@Url.Content(string.IsNullOrEmpty(project.ImgUrl)
													? "~/images/istockphoto-1311419248-612x612.jpg"
													: project.ImgUrl)"
									alt="@project.Name" class="project-strip-image" />
								}
								else
								{
									<img src="@Url.Content(string.IsNullOrEmpty(project.ImgUrl)
													? "~/images/istockphoto-1499593982-612x612.jpg"
													: project.ImgUrl)"
									alt="@project.Name" class="project-strip-image" />
								}
							</div>
						</a>

						<!-- Finish button below -->
						<div class="project-strip-bottom">
							<a asp-controller="Craft"
							   asp-action="FinishProject"
							   asp-route-id="@project.Id"
							   class="btn btn-finish">
								Finish Project
							</a>
						</div>

					</div>
				}
			}
		</div>

		<!-- FINISHED -->
		<div class="projects-column">
			<h3 class="column-title">Finished</h3>
			@if (!finished.Any())
			{
				<div class="patchwork-square">
					<div class="patch-content">
						<p>No finished projects yet</p>
					</div>
				</div>
			}
			else
			{
				@foreach (var project in finished)
				{
					<div class="project-strip-wrapper">

						<a asp-controller="Craft"
						   asp-action="Details"
						   asp-route-id="@project.Id"
						   class="project-strip-link">

							<div class="project-strip">

								<div class="project-strip-text">
									<h5>@project.Name</h5>
									<div class="project-meta">
										<span>@project.CraftType</span> ·
										<span>@project.Difficulty</span>
									</div>
								</div>

								@if (project.CraftType == CraftType.Crochet)
								{
									<img src="@Url.Content(string.IsNullOrEmpty(project.ImgUrl)
											? "~/images/istockphoto-1311419248-612x612.jpg"
											: project.ImgUrl)"
									alt="@project.Name" class="project-strip-image" />
								}
								else
								{
									<img src="@Url.Content(string.IsNullOrEmpty(project.ImgUrl)
											? "~/images/istockphoto-1499593982-612x612.jpg"
											: project.ImgUrl)"
									alt="@project.Name" class="project-strip-image" />
								}
							</div>
						</a>

					</div>
				}
			}
		</div>


	</div>
</section>
