@model InputModel

@{
    ViewData["Title"] = "Add " + @Model.CraftName + " Project";
    IEnumerable<SelectListItem> allProjectTypes = Model.ProjectTypes
        .Select(p => new SelectListItem()
                {
                    Text = p.Name,
                    Value = p.Id.ToString()
                })
        .ToList();
}


<div class="form-page">
    <div class="form-card">
        <h2 class="form-title">@ViewData["Title"]</h2>

        <form asp-action="Create" method="post">

            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-input" />
                <span asp-validation-for="Name" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" 
                    class="form-textarea"
                    rows="4"
                    placeholder="Write a short description for your project..."></textarea>
                <span asp-validation-for="Description" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="ImgUrl">Image URL</label>
                <input asp-for="ImgUrl" 
                type="url" 
                class="form-input"
                       placeholder="https://example.com/image.jpg" />
                <span asp-validation-for="ImgUrl" class="validation-error"></span>
            </div>
            @if (Model is CrochetInputModel crochet)
            {
                <div class="form-group">
                    <label asp-for="@crochet.StitchPatternId"></label>
                    <select asp-for="@crochet.StitchPatternId"
                            asp-items="@(new SelectList(crochet.StitchPatterns, "Id", "Name"))">
                    </select>
                </div>
            }
            <div class="form-group">
                <label asp-for="ProjectTypeId">Project Type</label>
                <select asp-for="ProjectTypeId"
                        asp-items="@(new SelectList(Model.ProjectTypes, "Id", "Name"))"
                        class="form-select">
                    <option value="">-- Select Project Type --</option>
                </select>
                <span asp-validation-for="ProjectTypeId" class="validation-error"></span>
            </div>

            <button type="submit" class="btn-submit">Add Project</button>
            <a asp-controller="@Model.CraftName" asp-action="All" asp-route-id="@Model.Id" class="btn btn-cancel">
                Cancel
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
