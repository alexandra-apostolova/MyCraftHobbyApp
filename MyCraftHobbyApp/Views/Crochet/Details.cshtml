@model DetailsCrochetViewModel

@{
    ViewData["Title"] = "Project Details";
}

<section class="project-details-page">
    <div class="container">

        <!-- Title + Back button -->
        <div class="details-header">
            <h1 class="project-details-title">@Model.Name</h1>
            <a asp-controller="Crochet" asp-action="All" class="craft-button">
                Back to Projects
            </a>
        </div>

        <!-- Details + Image -->
        <div class="details-content">
            <div class="details-text">
                <p><strong>Difficulty:</strong> @Model.Difficulty</p>
                <p><strong>Project Type:</strong> @Model.ProjectTypeName</p>
                <p><strong>Stitch Pattern:</strong> @Model.StitchPattern</p>
                <p>@Model.Description</p>

                <div class="details-buttons">
                    <a asp-controller="Crochet" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-welcome">Edit</a>

                    <a asp-controller="Crochet" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-delete btn-danger">
                        Delete
                    </a>

                    <a asp-controller="Crochet" asp-action="Start" asp-route-id="@Model.Id" class="btn btn-welcome btn-start">Start Project</a>
                </div>
            </div>

            <div class="details-image-wrapper">
                <img src="@Url.Content(string.IsNullOrEmpty(Model.ImgUrl)
                                                                         ? "~/images/Screenshot 2026-02-12 153744.png"
                                                                         : Model.ImgUrl)"
                     alt="@Model.Name" class="details-image" />
            </div>
        </div>
    </div>
</section>
