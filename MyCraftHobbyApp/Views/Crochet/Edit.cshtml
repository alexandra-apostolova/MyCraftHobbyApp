@model CrochetInputModel

@{
    ViewData["Title"] = "Crochet Knit Project";
    IEnumerable<SelectListItem> allProjectTypes = Model.ProjectTypes
        .Select(p => new SelectListItem()
        {
            Text = p.Name,
            Value = p.Id.ToString()
        })
        .ToList();

    IEnumerable<SelectListItem> allStitchPatterns = Model.StitchPatterns
    .Select(p => new SelectListItem()
    {
        Text = p.Name,
        Value = p.Id.ToString()
    })
    .ToList();
}


<div class="form-page">
    <div class="form-card">
        <h2 class="form-title">Edit Crochet Project</h2>

        <form asp-action="Edit" method="post">

            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-input" />
                <span asp-validation-for="Name" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description"></label>
                <textarea asp-for="Description"
                          class="form-textarea"
                          rows="4"
                          placeholder="Write a short description for your project..."></textarea>
                <span asp-validation-for="Description" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="ImgUrl">Image URL</label>
                <input asp-for="ImgUrl"
                       type="url"
                       class="form-input"
                       placeholder="https://example.com/image.jpg" />
                <span asp-validation-for="ImgUrl" class="validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="StitchPatternId">Stitch Pattern</label>
                <select asp-for="StitchPatternId"
                        asp-items="allStitchPatterns"
                        class="form-select">
                    <option value="">-- Select Stitch Pattern --</option>
                </select>
                <span asp-validation-for="StitchPatternId" class="validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="ProjectTypeId">Project Type</label>
                <select asp-for="ProjectTypeId"
                        asp-items="allProjectTypes"
                        class="form-select">
                    <option value="">-- Select Project Type --</option>
                </select>
                <span asp-validation-for="ProjectTypeId" class="validation-error"></span>
            </div>

            <button type="submit" class="btn-submit">Save Changes</button>
            <a asp-controller="Crochet" asp-action="All" asp-route-id="@Model.Id" class="btn btn-cancel">
                Cancel
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
